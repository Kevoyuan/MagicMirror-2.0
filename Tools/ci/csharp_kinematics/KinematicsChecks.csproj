<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Compile the SAME actual C# source file consumed by Unity, not a Python port. -->
  <ItemGroup>
    <Compile Include="../../../Unity/Assets/Scripts/Motion/TwoBoneKinematics.cs" Link="TwoBoneKinematics.cs" />
    <Compile Include="../../../Unity/Assets/Scripts/Motion/BodySimilarityCalibration.cs" Link="BodySimilarityCalibration.cs" />
    <Compile Include="../../../Unity/Assets/Scripts/Motion/BodyWorldCalibrationBridge.cs" Link="BodyWorldCalibrationBridge.cs" />
    <Compile Include="../../../Unity/Assets/Scripts/Motion/TwoBoneWorldPoseBridge.cs" Link="TwoBoneWorldPoseBridge.cs" />
    <Compile Include="../../../Unity/Assets/Scripts/Tracking/PoseStreamProtocol.cs" Link="PoseStreamProtocol.cs" />
    <Compile Include="../../../Unity/Assets/Scripts/Motion/BodyWorldPinholeCamera.cs" Link="BodyWorldPinholeCamera.cs" />
    <Compile Include="../../../Unity/Assets/Scripts/Motion/AtlasReprojectionDiagnostics.cs" Link="AtlasReprojectionDiagnostics.cs" />
    <Compile Include="../../../Unity/Assets/Scripts/Motion/ReferencePoseCaptureWindow.cs" Link="ReferencePoseCaptureWindow.cs" />
    <Compile Include="../../../Unity/Assets/Scripts/Motion/AtlasTwoLinkMotionPlanner.cs" Link="AtlasTwoLinkMotionPlanner.cs" />
  </ItemGroup>
</Project>
