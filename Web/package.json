{
  "name": "magicmirror-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "stage:assets": "node scripts/stage-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:code": "tsc --noEmit && vite build",
    "build": "npm run check:assets && npm run check:release && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.9.0",
    "vite": "8.3.6",
    "vitest": "^4.0.0"
  }
}
